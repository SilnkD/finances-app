{
  "moduleFileExtensions": ["js", "json", "ts"],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "rootDir": "../",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "preset": "ts-jest",
  "moduleDirectories": ["node_modules"],
  "collectCoverageFrom": [
    "src/**/*.{js,ts}",
    "!src/**/*.model.{js,ts}",  
    "!src/**/*.module.{js,ts}",
    "!src/**/*-dto.ts"
  ],
  "coverageDirectory": "../coverage",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
