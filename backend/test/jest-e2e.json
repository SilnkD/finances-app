{
  "moduleFileExtensions": ["js", "json", "ts"],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "rootDir": "../",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "preset": "ts-jest",
  "moduleDirectories": ["node_modules"],
  "collectCoverage": true,
  "collectCoverageFrom": [
    "src/**/*controller.{js,ts}",
    "src/**/*dto.{js,ts}"
  ],
  "coverageDirectory": "./coverage/e2e",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}